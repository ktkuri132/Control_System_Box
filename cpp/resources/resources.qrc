<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <!-- 图片资源 -->
        <file alias="images/icon.ico">images/icon.ico</file>
        <file alias="images/icon.jpg">images/icon.jpg</file>
        <file alias="images/splash.jpg">images/splash.jpg</file>

        <!-- 样式表 -->
        <file alias="styles/dark_theme.qss">styles/dark_theme.qss</file>
    </qresource>
</RCC>
